AGENTGUARD_DATABASE_URL=postgresql+asyncpg://agentguard:agentguard@postgres:5432/agentguard

AGENTGUARD_API_HOST=0.0.0.0
AGENTGUARD_API_PORT=8000
AGENTGUARD_ENVIRONMENT=production

# Hosted AgentGuard must require authentication.
AGENTGUARD_AUTH_REQUIRED=true
AGENTGUARD_BOOTSTRAP_API_KEY=

AGENTGUARD_ACCESS_TOKEN_MINUTES=60
AGENTGUARD_REFRESH_TOKEN_MINUTES=10080

AGENTGUARD_MAX_TRACE_SPANS=500
AGENTGUARD_MAX_INGESTION_BYTES=1048576

# Production evaluation queue. Local/test may use "inline"; hosted production
# must use "redis" so evaluations run in the worker process.
AGENTGUARD_EVALUATION_QUEUE_BACKEND=redis
AGENTGUARD_REDIS_URL=redis://redis:6379/0
AGENTGUARD_EVALUATION_JOB_TIMEOUT_SECONDS=300
AGENTGUARD_EVALUATION_WORKER_CONCURRENCY=4

# Local fallback database-backed worker
AGENTGUARD_EMBEDDED_WORKER_ENABLED=false
AGENTGUARD_WORKER_POLL_SECONDS=1
AGENTGUARD_WORKER_STALE_SECONDS=300

# Regression tolerances
AGENTGUARD_DETERMINISTIC_SCORE_TOLERANCE=0.05
AGENTGUARD_LLM_JUDGE_SCORE_TOLERANCE=0.05

# LLM judge: disabled | ollama | openai-compatible
AGENTGUARD_JUDGE_PROVIDER=disabled
AGENTGUARD_JUDGE_BASE_URL=https://api.openai.com/v1
AGENTGUARD_JUDGE_API_KEY=
AGENTGUARD_JUDGE_MODEL=gpt-4o-mini
AGENTGUARD_JUDGE_TIMEOUT_SECONDS=20

# Do not expose synthetic public demo seeding in production.
AGENTGUARD_DEMO_SEED_ENABLED=false

# Internal URLs
AGENTGUARD_API_URL=http://api:8000

# SDK
AGENTGUARD_API_KEY=

# Reference real-model app
DEMO_AGENT_PROVIDER=
DEMO_AGENT_OPENAI_API_KEY=
DEMO_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
DEMO_AGENT_OPENAI_MODEL=gpt-4o-mini
DEMO_RETRIEVAL_TOP_K=2
