{
  "name": "Incident Briefing Regression Suite",
  "slug": "incident-briefing-regression-suite",
  "description": "Checks whether the assistant can report incident owners, mitigations, causes, and follow-up decisions from stored evidence.",
  "metadata": {"domain": "engineering-incidents", "owner": "Amy walkthrough"},
  "cases": [
    {
      "name": "refresh-token-owner-and-cause",
      "input": {"question": "Who owned the refresh-token incident and what caused it?"},
      "expectations": {
        "answer_requirement": "Nia Brooks, expired signing keys",
        "required_sources": ["incident-104"],
        "expected_tool": "lookup_incident_metadata"
      },
      "evaluators": ["builtin.keyword_coverage", "builtin.required_source", "builtin.expected_tool", "builtin.runtime_success"]
    },
    {
      "name": "webhook-prevention-change",
      "input": {"question": "What changes were made to prevent duplicate webhook delivery?"},
      "expectations": {
        "answer_requirement": "idempotency-key enforcement, delivery record commits",
